{
  "name": "snapsort",
  "version": "0.0.1",
  "private": true,
  "description": "Swipe through your Google Photos library: keep, discard, add to albums.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "harness": "node scripts/build.mjs --harness",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
